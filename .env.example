# Optional local features. Copy to .env.local and supply your own values.
# Blank credentials keep integrations unavailable. Tests need no credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable providers only after their own configuration and end-to-end checks.
NEXT_PUBLIC_STUDY_GOOGLE_ENABLED=false
NEXT_PUBLIC_STUDY_EMAIL_ENABLED=false
NEXT_PUBLIC_STUDY_APPLE_ENABLED=false
# Optional private recruiter portal; leave disabled for ordinary local review.
RECRUITER_PORTAL_ENABLED=false
RECRUITER_PORTAL_ORIGIN=http://localhost:3000
RECRUITER_SUPABASE_SERVICE_ROLE_KEY=
RECRUITER_AUTOMATION_KEY=
RECRUITER_INVITE_API_KEY=
RECRUITER_CALL_EMAIL_KEY=
# Optional read-only GitHub workflow access for failure analysis.
GITHUB_ACTIONS_TOKEN=
