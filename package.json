{
  "name": "erdal-ai-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:study": "node --test tests/study-*.test.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "test:engineering-story": "node --test tests/engineering-story.test.mjs",
    "test:study-layout": "playwright test --config=playwright.study-layout.config.ts",
    "test:engineering-browser": "playwright test --config=playwright.engineering.config.ts",
    "render:engineering-share": "node scripts/render-engineering-share.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm test && npm run lint && npm run typecheck && npm run build",
    "audit:certifications": "node scripts/audit-certification-sources.mjs",
    "audit:certification-quality": "node scripts/audit-certification-quality.mjs",
    "postbuild": "node scripts/reading/audit-packed-build.mjs && node scripts/check-learning50-size.mjs",
    "audit:learning-inventory": "node scripts/audit-learning-inventory.mjs",
    "test:browser:ci": "playwright test --config=playwright.ci.config.ts",
    "test:monitor": "node --test tests/production-monitor.test.mjs",
    "monitor:http": "node scripts/monitor-production.mjs",
    "monitor:browser": "playwright test --config=playwright.production.config.ts",
    "audit:learning50": "node scripts/audit-reading50.mjs && node scripts/audit-learning-inventory.mjs",
    "audit:learning50-sources": "node scripts/audit-learning50-sources.mjs",
    "audit:homepage-performance": "node scripts/audit-homepage-performance.mjs",
    "test:recruiter-browser": "playwright test --config=playwright.recruiter.config.ts",
    "audit:knowledge-links": "node scripts/audit-knowledge-source-links.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^3.10.4",
    "katex": "^0.19.1",
    "next": "16.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "katex": "$katex"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT"
}
